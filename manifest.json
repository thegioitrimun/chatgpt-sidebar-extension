{
  "manifest_version": 3,
  "name": "ChatGPT Sidebar - Trợ lý AI",
  "version": "1.7.4",
  "description": "ChatGPT Sidebar: đọc trang, chuẩn bị lệnh và điền form bằng AI từ nội dung bạn cung cấp.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Mở ChatGPT Sidebar (Cmd+Shift+Y)"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "form-json.js",
        "quiz-common.js",
        "content/quiz-chat-dom.js",
        "content/quiz-chat.js",
        "content/chatgpt-inject.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://elearning.vinmec.com/*"],
      "js": ["content/quiz-extract.js", "content/quiz-page.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": [
    "sidePanel",
    "declarativeNetRequest",
    "storage",
    "tabs",
    "scripting",
    "contextMenus",
    "clipboardWrite",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "toggle-quiz-mode": {
      "suggested_key": { "default": "Alt+Shift+Q", "mac": "Alt+Shift+Q" },
      "description": "Bật/tắt đáp án tự động trên Vinmec"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Mở ChatGPT Sidebar"
    }
  },
  "minimum_chrome_version": "116"
}
